val io = @import("std.io")
val http = @import("std.http")
val os = @import("std.os")

fn main() {
  val order = []

  val handler = fn(req, res) {
    order.push("first")
    order.push("second")
    order.push("handler")
    http.json(res, { trace: order }, 200)
  }

  val server = http.createServer(handler)
  val handle = server.listen(39219, "127.0.0.1")
  os.sleep(150)

  val resp = http.get("http://127.0.0.1:39219/order")
  val trace = resp.json().trace

  io.log("step0:", trace[0])
  io.log("step1:", trace[1])
  io.log("step2:", trace[2])

  handle.close()
  io.log("PASS http_middleware_order")
}
