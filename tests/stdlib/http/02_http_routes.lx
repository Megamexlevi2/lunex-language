val io = @import("std.io")
val http = @import("std.http")
val router = @import("std.http.router")
val os = @import("std.os")

fn main() {
  val api = router.create([
    router.get("/users/:id", fn(req, res) {
      http.json(res, { id: req.params.id }, 200)
    }),
    router.post("/echo", fn(req, res) {
      val parsed = http.parseBody(req)
      http.json(res, parsed, 200)
    })
  ])

  val handle = api.listen(39218, "127.0.0.1")
  os.sleep(150)

  val getResp = http.get("http://127.0.0.1:39218/users/42")
  io.log("param_id:", getResp.json().id)

  val postResp = http.post("http://127.0.0.1:39218/echo", {
    json: { message: "hi" }
  })
  io.log("echoed:", postResp.json().message)

  handle.close()
  io.log("PASS http_routes")
}
