val testing = @import("std.testing")
val io = @import("std.io")

fn main() {
  testing.clear()

  testing.group("values", fn() {
    testing.test("truth", fn() {
      testing.ok(10 > 2)
      testing.falsey(false)
    })

    testing.test("deep equality", fn() {
      testing.equal({ name: "Lunex", items: [1, 2, { ok: true }] }, { name: "Lunex", items: [1, 2, { ok: true }] })
      testing.notEqual([1, 2], [1, 3])
      testing.same("x", "x")
      testing.contains(["a", "b", "c"], "b")
      testing.contains("Lunex testing", "testing")
      testing.type(42, "number")
    })

    testing.test("raises", fn() {
      val err = testing.raises(fn() {
        val value = 10 / 0
        value
      })
      testing.type(err, "object")
      testing.notRaises(fn() {
        val value = 2 + 2
        value
      })
    })

    testing.test("skipped", fn() {
      testing.fail("skipped test executed")
    }, { skip: true, reason: "feature gate" })

    testing.test("todo", fn() {
      testing.fail("expected pending behavior")
    }, { todo: true, reason: "pending coverage" })
  })

  val result = testing.run()
  testing.equal(result.total, 5)
  testing.equal(result.passed, 3)
  testing.equal(result.failed, 0)
  testing.equal(result.skipped, 1)
  testing.equal(result.todo, 1)
  testing.equal(result.unexpected, 0)
  testing.ok(result.ok)
  io.log("PASS std.testing")
}
