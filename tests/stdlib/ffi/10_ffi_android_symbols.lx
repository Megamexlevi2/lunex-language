val io = @import("std.io")
val os = @import("std.os")
val ffi = @import("std.ffi")

fn check(condition, message) {
  if !condition {
    throw "FAIL " + message
  }
}

fn runAndroidSymbols() {
  val libc = ffi.load("libc.so")
  val malloc = libc.bind("malloc", "ptr(usize)")
  val free = libc.bind("free", "void(ptr)")
  val memset = libc.bind("memset", "ptr(ptr, i32, usize)")
  val memcmp = libc.bind("memcmp", "i32(ptr, ptr, usize)")

  val first = malloc(16)
  val second = malloc(16)
  check(!ffi.isNull(first), "Android malloc returned null")
  check(!ffi.isNull(second), "Android second malloc returned null")

  memset(first, 65, 16)
  memset(second, 65, 16)
  check(memcmp(first, second, 16) == 0, "Android Bionic memory comparison failed")

  free(first)
  free(second)
  check(ffi.close(memcmp), "Android memcmp close failed")
  check(ffi.close(memset), "Android memset close failed")
  check(ffi.close(free), "Android free close failed")
  check(ffi.close(malloc), "Android malloc close failed")
  check(ffi.close(libc), "Android libc close failed")
  io.log("PASS ffi_android_symbols")
}

fn main() {
  if os.platform() == "android" {
    runAndroidSymbols()
  } else {
    io.log("PASS ffi_android_symbols_not_applicable")
  }
}
