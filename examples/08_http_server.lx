val io   = @import("std.io")
val http = @import("std.http")

fn handle(req, res) {
  if req.path == "/" {
    res.text("Hello from Lunex!")
  } elif req.path == "/ping" {
    res.json({ status: "ok" })
  } elif req.path == "/echo" {
    res.json({ url: req.url, method: req.method })
  } else {
    res.json({ error: "not found" }, 404)
  }
}

fn main() {
  val server = http.createServer(handle)
  server.listen(3000, "0.0.0.0", fn(port) {
    io.log(io.green("Server listening on http://localhost:" + str(port)))
    io.log("  GET /       -> text response")
    io.log("  GET /ping   -> json { status: ok }")
    io.log("  GET /echo   -> echo request info")
  })
}
